# Claude Browser Automation Extension - Environment Configuration
# Copy this file to .env and fill in your values. The setup script auto-fills
# SIGNING_SECRET with a strong random value — do not leave the default.

ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=8192

PROXY_PORT=3456
PROXY_HOST=127.0.0.1

# Only these chrome-extension IDs may call the proxy. "*" allows any extension
# origin but still blocks regular web pages. For strongest isolation, set this
# to your extension's exact ID (shown on chrome://extensions after loading).
ALLOWED_EXTENSION_IDS=*

# DANGER: allow the extension to run the Claude Code CLI on this machine via
# /api/claude-code. Effectively grants remote command execution. OFF by default.
ALLOW_CLAUDE_CODE_EXEC=false
CLAUDE_CODE_PATH=
CLAUDE_WORK_DIR=~/claude-browser-sessions
SESSION_TIMEOUT=30

MAX_CONCURRENT_AUTOMATIONS=5
PAGE_OPERATION_TIMEOUT=30000
SCREENSHOT_QUALITY=80

ENABLE_DOWNLOADS=true
DOWNLOAD_DIR=~/Downloads/claude-browser

# Request signing is ALWAYS required (the proxy refuses to start without a
# strong secret). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Paste the SAME value into the extension's
# Options page after loading it in Chrome.
SIGNING_SECRET=change-me-to-a-random-secret

RATE_LIMIT=60
LOG_LEVEL=info
FILE_LOGGING=false
LOG_FILE=./logs/proxy.log
